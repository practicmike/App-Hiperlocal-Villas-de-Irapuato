{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npx -y pnpm@10.28.0 install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@10.28.0 --filter @workspace/villas-web run build && npx -y pnpm@10.28.0 --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/villas-web/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
